# CodeQuest Environment Configuration Template
# Duplicate this file as .env and fill in your actual credentials.
# NOTE: Never commit your real .env to GitHub!

# Django Security
SECRET_KEY=django-insecure-codequest-im2-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL / Supabase)
# Option 1: Direct Connection URL (recommended for Supabase / PostgreSQL)
# Supabase shared pooler: percent-encode special characters in your password.
# Example Local Postgres: postgresql://postgres:postgres@localhost:5432/codequest_db
DATABASE_URL=postgresql://postgres.dvezfatxzzpvaukucpgw:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Option 2: Individual Database Parameters (Used if DATABASE_URL is not set)
DB_NAME=postgres
DB_USER=postgres.dvezfatxzzpvaukucpgw
DB_PASSWORD=[YOUR-PASSWORD]
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
